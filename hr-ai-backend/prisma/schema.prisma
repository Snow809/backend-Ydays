generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COLLABORATOR
  MANAGER
  HR
  DIRECTION
  ADMIN
  QVT
}

enum DocumentStatus {
  DRAFT
  VALIDATED
  ARCHIVED
}

enum GeneratedDocumentStatus {
  DRAFT
  IN_REVIEW
  VALIDATED
  REJECTED
}

enum AlertType {
  ONBOARDING_DELAY
  DATA_QUALITY
  AI_SECURITY
  SOCIAL_RISK
  DOCUMENT_MISSING
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  TREATED
  DISMISSED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  role                 UserRole              @default(COLLABORATOR)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  uploadedDocuments    HRDocument[]          @relation("UploadedDocuments")
  validatedDocuments   HRDocument[]          @relation("ValidatedDocuments")
  chatConversations    ChatConversation[]
  generatedDocuments   GeneratedDocument[]   @relation("RequestedGeneratedDocuments")
  validatedGenerations GeneratedDocument[]   @relation("ValidatedGeneratedDocuments")
  auditLogs            AuditLog[]
  loginHistories       LoginHistory[]
}

model Employee {
  id              String           @id @default(cuid())
  matricule       String           @unique
  email           String           @unique
  fullName        String
  position        String?
  department      String?
  site            String?
  managerId       String?
  hiredAt         DateTime?
  leftAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  manager         Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  reports         Employee[]       @relation("EmployeeManager")
  onboardingPlans OnboardingPlan[]
}

model HRDocument {
  id                String          @id @default(cuid())
  title             String
  category          String?
  version           String          @default("1.0")
  status            DocumentStatus  @default(DRAFT)
  filePath          String
  uploadedByUserId  String
  validatedByUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  uploadedBy        User            @relation("UploadedDocuments", fields: [uploadedByUserId], references: [id])
  validatedBy       User?           @relation("ValidatedDocuments", fields: [validatedByUserId], references: [id])
  chunks            DocumentChunk[]
}

model DocumentChunk {
  id         String     @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  sourcePage Int?
  // Placeholder until PostgreSQL pgvector is enabled. Later replace with Unsupported("vector") or a typed vector column.
  embedding  String?
  createdAt  DateTime   @default(now())
  document   HRDocument @relation(fields: [documentId], references: [id])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ChatMessageRole
  content        String
  sources        Json?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
}

model GeneratedDocument {
  id                String                  @id @default(cuid())
  type              String
  prompt            String
  draftContent      String?
  status            GeneratedDocumentStatus @default(DRAFT)
  requestedByUserId String
  validatedByUserId String?
  rejectionReason   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  requestedBy       User                    @relation("RequestedGeneratedDocuments", fields: [requestedByUserId], references: [id])
  validatedBy       User?                   @relation("ValidatedGeneratedDocuments", fields: [validatedByUserId], references: [id])
}

model OnboardingPlan {
  id         String           @id @default(cuid())
  employeeId String
  title      String
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  employee   Employee         @relation(fields: [employeeId], references: [id])
  steps      OnboardingStep[]
}

model OnboardingStep {
  id          String         @id @default(cuid())
  planId      String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  plan        OnboardingPlan @relation(fields: [planId], references: [id])
}

model Alert {
  id        String      @id @default(cuid())
  type      AlertType
  status    AlertStatus @default(OPEN)
  title     String
  message   String?
  targetId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])
}

model LoginHistory {
  id           String   @id @default(cuid())
  userId       String?
  email        String
  ipAddress    String?
  userAgent    String?
  status       String   @default("SUCCESS") // SUCCESS or FAILED
  loginAt      DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loginAt])
}
