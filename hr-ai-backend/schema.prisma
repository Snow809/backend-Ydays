generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COLLABORATOR
  MANAGER
  HR
  DIRECTION
  ADMIN
  QVT
}

enum DocumentStatus {
  DRAFT
  VALIDATED
  ARCHIVED
}

enum GeneratedDocumentStatus {
  DRAFT
  IN_REVIEW
  VALIDATED
  REJECTED
}

enum DocumentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  GENERATED
}

enum AlertType {
  ONBOARDING_DELAY
  DATA_QUALITY
  AI_SECURITY
  SOCIAL_RISK
  DOCUMENT_MISSING
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  TREATED
  DISMISSED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AbsenceStatus {
  RECORDED
  VALIDATED
  REJECTED
  CANCELLED
}

enum DataImportStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowType {
  ONBOARDING
  OFFBOARDING
}

enum WorkflowTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model User {
  id                       String               @id @default(cuid())
  email                    String               @unique
  passwordHash             String               @map("password_hash")
  fullName                 String?              @map("full_name")
  role                     UserRole             @default(COLLABORATOR)
  isActive                 Boolean              @default(true) @map("is_active")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  employee                 Employee?
  roleAssignments          UserRoleAssignment[]
  uploadedDocuments        HRDocument[]         @relation("UploadedDocuments")
  validatedDocuments       HRDocument[]         @relation("ValidatedDocuments")
  createdDocumentTemplates DocumentTemplate[]   @relation("CreatedDocumentTemplates")
  chatConversations        ChatConversation[]
  chatMessages             ChatMessage[]
  generatedDocuments       GeneratedDocument[]  @relation("RequestedGeneratedDocuments")
  validatedGenerations     GeneratedDocument[]  @relation("ValidatedGeneratedDocuments")
  assignedWorkflowTasks    WorkflowTask[]       @relation("AssignedWorkflowTasks")
  securityAlerts           SecurityAlert[]
  auditLogs                AuditLog[]           @relation("UserAuditLogs")
  loginHistories           LoginHistory[]
  dataImports              DataImport[]         @relation("ImportedData")

  @@map("users")
}

model Role {
  id          String               @id @default(cuid())
  name        UserRole             @unique
  description String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  users       UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id           String        @id @default(cuid())
  name         String
  managerId    String?       @map("manager_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  manager      Employee?     @relation("DepartmentManager", fields: [managerId], references: [id])
  employees    Employee[]    @relation("EmployeeDepartment")
  kpiSnapshots KpiSnapshot[]

  @@map("departments")
}

model JobPosition {
  id          String     @id @default(cuid())
  title       String
  level       String?
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  employees   Employee[]

  @@map("job_positions")
}

model Employee {
  id                      String              @id @default(cuid())
  userId                  String?             @unique @map("user_id")
  departmentId            String?             @map("department_id")
  positionId              String?             @map("position_id")
  managerId               String?             @map("manager_id")
  matricule               String              @unique
  email                   String              @unique
  fullName                String              @map("full_name")
  firstName               String?             @map("first_name")
  lastName                String?             @map("last_name")
  phone                   String?
  position                String?
  department              String?
  site                    String?
  hiredAt                 DateTime?           @map("hired_at")
  leftAt                  DateTime?           @map("left_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  user                    User?               @relation(fields: [userId], references: [id])
  departmentEntity        Department?         @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  positionEntity          JobPosition?        @relation(fields: [positionId], references: [id])
  manager                 Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  reports                 Employee[]          @relation("EmployeeManager")
  managedDepartments      Department[]        @relation("DepartmentManager")
  absences                Absence[]
  hrDocuments             HRDocument[]
  generatedDocuments      GeneratedDocument[]
  documentRequests        DocumentRequest[]   @relation("EmployeeDocumentRequests")
  managedDocumentRequests DocumentRequest[]   @relation("ManagerDocumentRequests")
  onboardingPlans         OnboardingPlan[]
  workflowTasks           WorkflowTask[]
  predictionScores        PredictionScore[]

  @@map("employees")
}

model Absence {
  id           String        @id @default(cuid())
  employeeId   String        @map("employee_id")
  absenceType  String        @map("absence_type")
  startDate    DateTime      @map("start_date")
  endDate      DateTime      @map("end_date")
  durationDays Float?        @map("duration_days")
  reason       String?
  status       AbsenceStatus @default(RECORDED)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  employee     Employee      @relation(fields: [employeeId], references: [id])

  @@map("absences")
}

model HRDocument {
  id                   String          @id @default(cuid())
  employeeId           String?         @map("employee_id")
  title                String
  category             String?
  documentType         String?         @map("document_type")
  version              String          @default("1.0")
  status               DocumentStatus  @default(DRAFT)
  filePath             String          @map("file_path")
  confidentialityLevel String?         @map("confidentiality_level")
  uploadedByUserId     String          @map("uploaded_by_user_id")
  validatedByUserId    String?         @map("validated_by_user_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  employee             Employee?       @relation(fields: [employeeId], references: [id])
  uploadedBy           User            @relation("UploadedDocuments", fields: [uploadedByUserId], references: [id])
  validatedBy          User?           @relation("ValidatedDocuments", fields: [validatedByUserId], references: [id])
  chunks               DocumentChunk[]

  @@map("hr_documents")
}

model DocumentTemplate {
  id              String            @id @default(cuid())
  name            String
  type            String
  description     String?
  filePath        String            @map("file_path")
  variables       String[]          @default([])
  isActive        Boolean           @default(true) @map("is_active")
  createdByUserId String            @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  createdBy       User              @relation("CreatedDocumentTemplates", fields: [createdByUserId], references: [id])
  requests        DocumentRequest[]

  @@map("document_templates")
}

model DocumentRequest {
  id                  String                @id @default(cuid())
  templateId          String                @map("template_id")
  employeeId          String                @map("employee_id")
  managerId           String?               @map("manager_id")
  generatedDocumentId String?               @unique @map("generated_document_id")
  status              DocumentRequestStatus @default(PENDING)
  rejectionReason     String?               @map("rejection_reason")
  generatedFilePath   String?               @map("generated_file_path")
  generatedContent    String?               @map("generated_content")
  requestedAt         DateTime              @default(now()) @map("requested_at")
  reviewedAt          DateTime?             @map("reviewed_at")
  generatedAt         DateTime?             @map("generated_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  template            DocumentTemplate      @relation(fields: [templateId], references: [id])
  employee            Employee              @relation("EmployeeDocumentRequests", fields: [employeeId], references: [id])
  manager             Employee?             @relation("ManagerDocumentRequests", fields: [managerId], references: [id])
  generatedDocument   GeneratedDocument?    @relation("DocumentRequestGeneratedDocument", fields: [generatedDocumentId], references: [id])

  @@map("document_requests")
}

model DocumentChunk {
  id         String     @id @default(cuid())
  documentId String     @map("document_id")
  content    String
  chunkIndex Int        @map("chunk_index")
  sourcePage Int?       @map("source_page")
  // Placeholder until PostgreSQL pgvector is enabled.
  // Later replace with Unsupported("vector") or a typed vector column.
  embedding  String?
  createdAt  DateTime   @default(now()) @map("created_at")
  document   HRDocument @relation(fields: [documentId], references: [id])

  @@map("document_chunks")
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  title     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]

  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  userId         String?          @map("user_id")
  role           ChatMessageRole
  content        String
  category       String?
  sources        Json?
  wasBlocked     Boolean          @default(false) @map("was_blocked")
  blockReason    String?          @map("block_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  user           User?            @relation(fields: [userId], references: [id])
  securityAlerts SecurityAlert[]

  @@map("chat_messages")
}

model GeneratedDocument {
  id                String                  @id @default(cuid())
  employeeId        String?                 @map("employee_id")
  type              String
  prompt            String
  draftContent      String?                 @map("draft_content")
  filePath          String?                 @map("file_path")
  status            GeneratedDocumentStatus @default(DRAFT)
  requestedByUserId String                  @map("requested_by_user_id")
  validatedByUserId String?                 @map("validated_by_user_id")
  rejectionReason   String?                 @map("rejection_reason")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  employee          Employee?               @relation(fields: [employeeId], references: [id])
  requestedBy       User                    @relation("RequestedGeneratedDocuments", fields: [requestedByUserId], references: [id])
  validatedBy       User?                   @relation("ValidatedGeneratedDocuments", fields: [validatedByUserId], references: [id])
  documentRequest   DocumentRequest?        @relation("DocumentRequestGeneratedDocument")

  @@map("generated_documents")
}

model OnboardingPlan {
  id         String           @id @default(cuid())
  employeeId String           @map("employee_id")
  title      String
  startsAt   DateTime?        @map("starts_at")
  endsAt     DateTime?        @map("ends_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  employee   Employee         @relation(fields: [employeeId], references: [id])
  steps      OnboardingStep[]

  @@map("onboarding_plans")
}

model OnboardingStep {
  id          String         @id @default(cuid())
  planId      String         @map("plan_id")
  title       String
  description String?
  dueDate     DateTime?      @map("due_date")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  plan        OnboardingPlan @relation(fields: [planId], references: [id])

  @@map("onboarding_steps")
}

model WorkflowTask {
  id           String             @id @default(cuid())
  employeeId   String             @map("employee_id")
  assignedToId String?            @map("assigned_to_id")
  workflowType WorkflowType       @map("workflow_type")
  title        String
  description  String?
  dueDate      DateTime?          @map("due_date")
  status       WorkflowTaskStatus @default(TODO)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  employee     Employee           @relation(fields: [employeeId], references: [id])
  assignedTo   User?              @relation("AssignedWorkflowTasks", fields: [assignedToId], references: [id])

  @@map("workflow_tasks")
}

model Alert {
  id        String      @id @default(cuid())
  type      AlertType
  status    AlertStatus @default(OPEN)
  title     String
  message   String?
  targetId  String?     @map("target_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("alerts")
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String   @map("recipient_id")
  title       String
  message     String?
  type        String   @default("INFO")
  referenceId String?  @map("reference_id")
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([recipientId])
  @@index([isRead])
  @@map("notifications")
}

model SecurityAlert {
  id        String       @id @default(cuid())
  userId    String?      @map("user_id")
  messageId String?      @map("message_id")
  alertType String       @map("alert_type")
  severity  String
  status    String       @default("OPEN")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User?        @relation(fields: [userId], references: [id])
  message   ChatMessage? @relation(fields: [messageId], references: [id])

  @@map("security_alerts")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation("UserAuditLogs", fields: [actorUserId], references: [id])

  @@map("audit_logs")
}

model KpiSnapshot {
  id           String      @id @default(cuid())
  departmentId String?     @map("department_id")
  kpiName      String      @map("kpi_name")
  kpiValue     Float       @map("kpi_value")
  periodStart  DateTime    @map("period_start")
  periodEnd    DateTime    @map("period_end")
  calculatedAt DateTime    @default(now()) @map("calculated_at")
  department   Department? @relation(fields: [departmentId], references: [id])

  @@map("kpi_snapshots")
}

model PredictionScore {
  id             String    @id @default(cuid())
  employeeId     String    @map("employee_id")
  predictionType String    @map("prediction_type")
  score          Float
  riskLevel      RiskLevel @map("risk_level")
  explanation    Json?
  calculatedAt   DateTime  @default(now()) @map("calculated_at")
  employee       Employee  @relation(fields: [employeeId], references: [id])

  @@map("prediction_scores")
}

model DataImport {
  id           String           @id @default(cuid())
  importedById String?          @map("imported_by_id")
  importType   String           @map("import_type")
  fileName     String?          @map("file_name")
  status       DataImportStatus @default(PENDING)
  totalRows    Int?             @map("total_rows")
  errorRows    Int?             @map("error_rows")
  errorReport  Json?            @map("error_report")
  importedAt   DateTime         @default(now()) @map("imported_at")
  importedBy   User?            @relation("ImportedData", fields: [importedById], references: [id])

  @@map("data_imports")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String?
  userAgent String?
  status    String   @default("SUCCESS") // SUCCESS or FAILED
  loginAt   DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loginAt])
}
